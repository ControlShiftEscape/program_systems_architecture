@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true

' === БЛОК СОБЫТИЙ (ПОЛИМОРФИЗМ) ===
rectangle "События системы" #FFEBEE {
    class Event {
        <<abstract>>
        # time: double
        + {abstract} handle(engine: SimulationEngine)
        + getTime(): double
    }
    
    class ArrivalEvent {
        - sourceId: int
        - request: Request
        + handle(engine: SimulationEngine)
    }
    
    class ServiceEndEvent {
        - deviceId: int
        + handle(engine: SimulationEngine)
    }
    
    class ScheduleNextEvent {
        - sourceId: int
        + handle(engine: SimulationEngine)
    }
    
}

Event <|-- ArrivalEvent
Event <|-- ServiceEndEvent
Event <|-- ScheduleNextEvent


note bottom of ArrivalEvent
  **Архитектурный триггер**
  ВХОДИТ в sequence diagramm
  Будит Диспетчера Постановки (ДП)
end note

note bottom of ServiceEndEvent
  **Архитектурный триггер**
  ВХОДИТ в sequence diagramm
  Будит Диспетчера Выбора (ДВ)
end note

note bottom of ScheduleNextEvent
  **Служебное событие**
  НЕ входит в sequence diagramm
  Планирование следующей генерации (внутри Source)
end note

class SimulationEngine {
  - eventQueue: PriorityQueue<Event>

  - dp: DispatcherPlacement
  - dv: DispatcherSelection
  - buffer: RingBuffer

  - sources: List<Source>
  - devices: List<Device>

  - currentTime: double
  - const MAX_SIM_TIME: double

  - processNextEvent()
  - getStatistics(PlayerProfileStore storage): Map
  + runSimulation()
}

class Source {
  - id: int
  - lambda: double ' Параметр для ИЗ1
  - nextGenerationTime: double
  
  + generateRequest(): Request ' Генерация по ИЗ1
  + scheduleNextRequest()
}

class Request {
  - id: int
  - sourceId: int
  - generationTime: double
  - arrivalTime: double
  - payload: TelemetryData ' 
  
  + getAge(currentTime): double
  + getPayload(): TelemetryData
}

note left of Request
Основная структура-обертка, которая 
будет проходить цикл обработки
end note

class TelemetryData {
  - playerId: int
  - tickTimestamp: double          ' Время начала этого 100мс тика
  
  ' Движение (Массив сэмплов за период)
  - positionSamples: List<Point3D> ' Массив позиций за последние N кадров
  - movementVectors: List<Vector3D>' Массив векторов скорости за период
  
  ' Агрегированные метрики (вычисляются на клиенте для экономии трафика)
  - maxSpeed100ms: double          ' Максимальная скорость за тик
  - aimJitterScore: double         ' Оценка "дрожания" прицела за период (0-1)
}

note right of TelemetryData

end note

class TelemetryAnalyzer {
  - threshold: double
  + analyze(data: TelemetryData): AnalysisResult
}

class AnalysisResult {
  - playerId: int
  - suspicionScore: double ' От 0.0 до 1.0 (насколько тик был подозрителен)
  - reason: String
  - timestamp: double
}
note left of AnalysisResult

end note

class PlayerProfile {
  - playerId: int
  - playerStatus : PlayerStatus
  - sessionStartTime: double
  - currentSuspicionScore: double ' Накопленный счетчик
  - static banThreshold: double ' Порог для бана, например, 0.95
  - static warningThreshold: double ' Порог для варна/мутa
  
  - decayScore(timePassed: double) ' Старые подозрения со временем затухают
  + addResult(result: AnalysisResult)
  + getStatus(): PlayerStatus ' NORMAL, WARNING, BANNED
}

class PlayerProfileStore {
 - profiles: Map  ' Map<int, PlayerProfile> 
  
  + getOrCreateProfile(playerId: int): PlayerProfile
  + processResult(result: AnalysisResult)
  + getStatistics()
}


class RingBuffer {
  - capacity: int
  - slots: List<Request>
  - writePointer: int ' Для Д10З1
  - readPointer: int ' Для Д2Б3
  - count: int
  
  + isFull(): boolean
  + isEmpty(): boolean
  + writeRequest(req: Request): Request ' Возвращает отказанную заявку
  + findOldestRequest(): Request ' Логика Д10О3
  + readNextRequest(): Request ' Логика Д2Б3
}

class DispatcherPlacement {
  - buffer: RingBuffer ' Ссылка на буфер
  - devices: List<Device> ' Ссылка на приборы
  
  + handleNewRequest(req: Request) 'Реакция на триггер: пришла заявка
  - findFreeDevice(): Device ' Логика Д2П1
}

class DispatcherSelection {
  - buffer: RingBuffer ' Ссылка на буфер
  - devices: List<Device> ' Ссылка на приборы
  
  + handleDeviceFree(device: Device) ' Реакция на триггер: прибор освободился
  - selectNextRequest(): Request ' Логика Д2Б3
  - assignToDevice(req: Request, device: Device)
}

class Device {
  - id: int ' Для Д2П1
  - mu: double ' Параметр для ПЗ1
  - isBusy: boolean
  - currentRequest: Request
  - analyzer: TelemetryAnalyzer
  - resultStore: PlayerProfileStore
  
  + process(req: Request) ' Обслуживание по ПЗ1
  + isFree()
}

SimulationEngine "1" *-- "*" Source
SimulationEngine "1" *-- "*" Device
SimulationEngine "1" *-- "1" RingBuffer
SimulationEngine "1" *-- "1" DispatcherPlacement
SimulationEngine "1" *-- "1" DispatcherSelection

DispatcherPlacement --> RingBuffer : использует
DispatcherPlacement --> Device : назначает
DispatcherSelection --> RingBuffer : забирает
DispatcherSelection --> Device : назначает

Device --> TelemetryAnalyzer : использует для анализа
Device --> PlayerProfileStore : отправляет результат
TelemetryAnalyzer ..> AnalysisResult : возвращает
PlayerProfileStore "1" *-- "*" PlayerProfile : хранит
PlayerProfileStore --> AnalysisResult : принимает
Request --> TelemetryData : содержит payload

@enduml