@startuml
skinparam classAttributeIconSize 0
skinparam monochrome false

interface RequestHandler {
  + onServed(req: Request, finishTime: double)
}

interface Payload #LightGreen {
  + getTimestamp(): double
}

enum PlayerState #LightGreen {
  NORMAL
  WARNING
  BANNED
}

class Point3D #LightGreen {
  - x: double
  - y: double
  - z: double
}

class Vector3D #LightGreen {
  - x: double
  - y: double
  - z: double
}

enum LogType #LightGreen {
  EVENT
  GENERATION
  BUFFER_WRITE
  BUFFER_READ
  REJECTION
  SERVICE_START
  SERVICE_END
  STATE
  STATISTICS
}

class Logger #LightGreen {
  - logs: Map<LogType, List<Log>>
  
  + log(type: LogType, log: Log)
  + getLogs(type: LogType): List<Log>
  + clear()
  + printAll()
  - toString(type: LogType): String
}

class Log #LightGreen {
  - date: double
  - logContent: String
  
  + getLogContent(): String
  + getLogDate(): double
}

Logger --> LogType : использует
Logger --> Log : использует



TelemetryData --> Point3D : содержит
TelemetryData --> Vector3D : содержит
PlayerProfile --> PlayerState : использует

' === БЛОК СОБЫТИЙ (ПРОСТОЕ НАСЛЕДОВАНИЕ) ===
rectangle "События системы" {

    enum EventType #LightGreen {
      SERVICE_END = 0
      ARRIVAL = 1
    }
  
    class Event #LightGreen {
        <<abstract>>
        # time: double

        # Event(time: double)
        + {abstract} handle(engine: SimulationEngine)
        + {abstract} getType(): EventType
        + getTime(): double
    }

    class ArrivalEvent #LightGreen {
        - request: unique_ptr<Request>
        + handle(engine: SimulationEngine)
        + getType(): EventType
        + getRequest(): unique_ptr<Request>
    }

    class ServiceEndEvent #LightGreen {
        - deviceId: int
        + handle(engine: SimulationEngine)
        + getType(): EventType
        + getDeviceId(): int
    }
}

Event <|-- ArrivalEvent
Event <|-- ServiceEndEvent

Event --> EventType : использует
Event ..> SimulationEngine : использует
ArrivalEvent --> Request : владеет (unique_ptr)

note top of Event
  Виртуальная база для всех видов событий.
  Хранит время для сортировки в priority_queue.
end note

note top of EventType
  Константы имеют смысл при совпадении времени:
  SERVICE_END (0) обрабатывается раньше ARRIVAL (1).
end note

note bottom of ArrivalEvent
  **Архитектурный триггер**
  ВХОДИТ в sequence diagramm
  Будит Диспетчера Постановки (ДП)
end note

note bottom of ServiceEndEvent
  **Архитектурный триггер**
  ВХОДИТ в sequence diagramm
  Будит Диспетчера Выбора (ДВ)
end note

class SimulationEngine {
  - scheduler: EventScheduler
  - requestHandler: RequestHandler

  - dp: DispatcherPlacement
  - dv: DispatcherSelection
  - buffer: RingBuffer

  - sources: List<Source>
  - devices: List<Device>

  - currentTime: double
  - const MAX_SIM_TIME: double

  - processNextEvent()
  - getStatistics(): Map<String, double>
  + runSimulation()
}


interface Emulator #LightGreen {
  + emulate(playerId: int, cheatLevel: double, currentTime: double): Payload
}

class TelemetryEmulator #LightGreen {
  + emulate(playerId: int, cheatLevel: double, currentTime: double): Payload
}

TelemetryEmulator ..|> Emulator : реализует

note bottom of TelemetryEmulator
  Stateless-сервис.
  Не хранит состояние игрока,
  интерпретирует cheatLevel из аргументов.
end note

class EmulatorContext #LightGreen {
  <<abstract>>
}

class ACContext #LightGreen {
  - playerId: int
  - cheatLevel: double
  - currentTime: double
  
  + getPlayerId(): int
  + getCheatLevel(): double
  + getCurrentTime(): double
}

EmulatorContext <|-- ACContext


Source --> EmulatorContext : хранит ссылку

class Source {
  - scheduler: EventScheduler
  - logger: Logger
  - emulator: Emulator
  - context: EmulatorContext

  - id: int
  - lambda: double ' Параметр для ИЗ1
  
  + generateRequest(currentTime: double): Request ' Генерация по ИЗ1 и через Emulator
  + generateNextInterval(currentTime: double): double ' просто время след. запуска
}

Source --> Emulator : использует

class Request #LightGreen {
  - id: int
  - sourceId: int
  - generationTime: double
  - payload: std::unique_ptr<Payload>
  
  + getAge(currentTime): double
  + getPayload(): Payload
}

note left of Request
Основная структура-обертка, которая 
будет проходить цикл обработки
end note

class TelemetryData #LightGreen {
  - playerId: int
  - tickTimestamp: double
  - positionSamples: List<Point3D>
  - movementVectors: List<Vector3D>
  - maxSpeed100ms: double
  - aimJitterScore: double
  
  + getTimestamp(): double

  + getPlayerId(): int
  + getMetrics(): Map<String, double>
}

TelemetryData ..|> Payload : реализует

class TelemetryAnalyzer {
  - threshold: double
  + analyze(data: TelemetryData): ACAnalysisResult
}

interface BaseAnalysisResult #LightGreen {
  + getTimestamp(): double
}

class ACAnalysisResult #LightGreen {
  - playerId: int
  - suspicionScore: double ' От 0.0 до 1.0
  - reason: String
  - timestamp: double
  
  + getPlayerId(): int
  + getSuspicionScore(): double
  + getReason(): String
  + getTimestamp(): double
}

BaseAnalysisResult <|.. ACAnalysisResult : реализует

class PlayerProfile {
  - playerId: int
  - PlayerState : PlayerState
  - sessionStartTime: double
  - currentSuspicionScore: double ' Накопленный счетчик
  - static banThreshold: double ' Порог для бана, например, 0.95
  - static warningThreshold: double ' Порог для варна/мутa
  
  - decayScore(timePassed: double) ' Старые подозрения со временем затухают
  + mergeResult(result: ACAnalysisResult)
  + getStatus(): PlayerState ' NORMAL, WARNING, BANNED
}

class PlayerProfileStore {
 - profiles: Map<int, PlayerProfile>  ' Map<int, PlayerProfile> 
  
  + getOrCreateProfile(playerId: int): PlayerProfile
  + processResult(result: ACAnalysisResult)
  + getStatistics()
}


class RingBuffer #LightGreen {
  - capacity: int
  - slots: List<unique_ptr<Request>>
  - writePointer: int
  - readPointer: int
  - count: int
  
  + isFull(): boolean
  + isEmpty(): boolean
  + write(req: unique_ptr<Request>): unique_ptr<Request>
  + readNext(): std::unique_ptr<Request>
  + findOldest(): Request
}

note right of RingBuffer
  Хранит заявки в кольцевом буфере.
  findOldest() ищет заявку с минимальным
  generationTime для реализации Д10О3
end note

class DispatcherPlacement {
  - scheduler: EventScheduler
  - logger: Logger

  - buffer: RingBuffer ' Ссылка на буфер
  - devices: List<Device> ' Ссылка на приборы
  
  + handleNewRequest(req: Request) 'Реакция на триггер: пришла заявка
  - findFreeDevice(): Device ' Логика Д2П1
}

class DispatcherSelection {
  - scheduler: EventScheduler
  - logger: Logger

  - buffer: RingBuffer ' Ссылка на буфер
  - devices: List<Device> ' Ссылка на приборы
  
  + handleDeviceFree(device: Device) ' Реакция на триггер: прибор освободился
  - selectNextRequest(): Request ' Логика Д2Б3
  - assignToDevice(req: Request, device: Device)
}

class Device {
  - currentRequest: Request
  - scheduler: EventScheduler
  - handler: RequestHandler
  - logger: Logger

  - id: int ' Для Д2П1
  - mu: double ' Параметр для ПЗ1
  - isBusy: boolean
  - serviceStartTime: double
  - busyTime: double

  - generateServiceTime(): double
  + start(req: Request, now: double): double
  + finish(now: double): Request
  + isFree(): boolean
  + getBusyTime(): double
  
}
note left of Device
  Обращается к обработчику реквестов
  Использует свои вычислительные мощности для исполнения
  анализа через анализатор обработчика и сохранения в
  хранилище обработчика
end note

Device --> EventScheduler : планирует SERVICE_END
Device --> RequestHandler : уведомляет об окончании

class AntiCheatHandler {
  - analyzer: TelemetryAnalyzer
  - resultStore: PlayerProfileStore
  
  + onServed(req: Request, finishTime: double)
}
note top of AntiCheatHandler
  Описывает кто анализирует реквесты
  Описывает куда складывать результаты анализа реквестов
end note

class EventScheduler {
  - eventQueue: priority_queue<unique_ptr<Event>>
  - logger: Logger

  + schedule(event: Event)
  + getNextEvent(): Event
  + isEmpty(): boolean
}

SimulationEngine "1" *-- "*" Source
SimulationEngine "1" *-- "*" Device
SimulationEngine "1" *-- "1" RingBuffer
SimulationEngine "1" *-- "1" DispatcherPlacement
SimulationEngine "1" *-- "1" DispatcherSelection
SimulationEngine "1" *-- "1" EventScheduler : processNextEvent берёт события через getNextEvent()
SimulationEngine --> RequestHandler : использует

Source --> EventScheduler : планирует следующую генерацию
DispatcherPlacement --> EventScheduler : планирует
DispatcherSelection --> EventScheduler : планирует

DispatcherPlacement --> RingBuffer : использует
DispatcherPlacement --> Device : назначает
DispatcherSelection --> RingBuffer : забирает
DispatcherSelection --> Device : назначает


TelemetryAnalyzer ..> ACAnalysisResult : возвращает
PlayerProfileStore "1" *-- "*" PlayerProfile : хранит
PlayerProfileStore --> ACAnalysisResult : принимает
Request --> Payload : содержит payload

AntiCheatHandler ..|> RequestHandler : реализует
AntiCheatHandler --> TelemetryAnalyzer : использует
AntiCheatHandler --> PlayerProfileStore : сохраняет результат

@enduml