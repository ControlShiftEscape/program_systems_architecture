@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true

interface RequestHandler {
  + onServed(req: Request, finishTime: double)
}

interface Payload {
  + getPlayerId(): int
  + getTimestamp(): double
  + getMetrics(): Map
}

enum PlayerStatus {
  NORMAL
  WARNING
  BANNED
}

class Point3D {
  - x: double
  - y: double
  - z: double
}

class Vector3D {
  - x: double
  - y: double
  - z: double
}

enum LogType {
  EVENT
  GENERATION
  BUFFER_WRITE
  BUFFER_READ
  REJECTION
  SERVICE_START
  SERVICE_END
  STATE
  STATISTICS
}

class Logger {
  - logs: Map<LogType, List<Log>>
  
  + log(type: LogType, log: Log)
  + getLogs(type: LogType): List<Log>
  + clear()
  + printAll()
  - toString(type: LogType): String
}

class Log {
  - date: double
  - logContent: string
  
  + getLogContent(): List<string>
  + getLogDate(): double
}

Logger --> LogType : использует
Logger --> Log : использует

SimulationEngine --> Logger : логирует события
Source --> Logger : логирует генерацию
Device --> Logger : логирует обслуживание
DispatcherPlacement --> Logger : логирует отказы
DispatcherSelection --> Logger : логирует выборку

TelemetryData --> Point3D : содержит
TelemetryData --> Vector3D : содержит
PlayerProfile --> PlayerStatus : использует

' === БЛОК СОБЫТИЙ (ПОЛИМОРФИЗМ) ===
rectangle "События системы" #FFEBEE {
    class Event {
        <<abstract>>
        # time: double
        + {abstract} handle(engine: SimulationEngine)
        + getTime(): double
    }
    
    class ArrivalEvent {
        - sourceId: int
        - request: Request
        + handle(engine: SimulationEngine)
    }
    
    class ServiceEndEvent {
        - deviceId: int
        + handle(engine: SimulationEngine)
    }
    
    class ScheduleNextEvent {
        - sourceId: int
        + handle(engine: SimulationEngine)
    }
    
}

Event <|-- ArrivalEvent
Event <|-- ServiceEndEvent
Event <|-- ScheduleNextEvent

note top of Event
Виртуальная база для всех видов событий
end note

note bottom of ArrivalEvent
  **Архитектурный триггер**
  ВХОДИТ в sequence diagramm
  Будит Диспетчера Постановки (ДП)
end note

note bottom of ServiceEndEvent
  **Архитектурный триггер**
  ВХОДИТ в sequence diagramm
  Будит Диспетчера Выбора (ДВ)
end note

note bottom of ScheduleNextEvent
  **Служебное событие**
  НЕ входит в sequence diagramm
  Планирование следующей генерации (внутри Source)
end note

class SimulationEngine {
  - scheduler: EventScheduler
  - reqestHanlder: RequestHandler

  - dp: DispatcherPlacement
  - dv: DispatcherSelection
  - buffer: RingBuffer

  - sources: List<Source>
  - devices: List<Device>

  - currentTime: double
  - const MAX_SIM_TIME: double

  - processNextEvent()
  - getStatistics(): Map
  + runSimulation()
}

class Source {
  - scheduler: EventScheduler
  - logger Logger

  - id: int
  - lambda: double ' Параметр для ИЗ1
  
  + generateRequest(): Request ' Генерация по ИЗ1
  + scheduleNextRequest(): double ' просто время след. запуска
}

class Request {
  - id: int
  - sourceId: int
  - generationTime: double
  - arrivalTime: double
  - payload: Payload 
  
  + operator<(other: Request): boolean
  + getAge(currentTime): double
  + getPayload(): TelemetryData
}

note left of Request
Основная структура-обертка, которая 
будет проходить цикл обработки
Реализует оператор <
по generationTime
для использования в RingBuffer<Request>
end note

class TelemetryData {
  - playerId: int
  - tickTimestamp: double
  - positionSamples: List<Point3D>
  - movementVectors: List<Vector3D>
  - maxSpeed100ms: double
  - aimJitterScore: double
  
  + getPlayerId(): int
  + getTimestamp(): double
  + getMetrics(): Map
}

TelemetryData ..|> Payload : реализует

class TelemetryAnalyzer {
  - threshold: double
  + analyze(data: TelemetryData): AnalysisResult
}

class AnalysisResult {
  - playerId: int
  - suspicionScore: double ' От 0.0 до 1.0 (насколько тик был подозрителен)
  - reason: String
  - timestamp: double
}
note left of AnalysisResult

end note

class PlayerProfile {
  - playerId: int
  - playerStatus : PlayerStatus
  - sessionStartTime: double
  - currentSuspicionScore: double ' Накопленный счетчик
  - static banThreshold: double ' Порог для бана, например, 0.95
  - static warningThreshold: double ' Порог для варна/мутa
  
  - decayScore(timePassed: double) ' Старые подозрения со временем затухают
  + addResult(result: AnalysisResult)
  + getStatus(): PlayerStatus ' NORMAL, WARNING, BANNED
}

class PlayerProfileStore {
 - profiles: Map  ' Map<int, PlayerProfile> 
  
  + getOrCreateProfile(playerId: int): PlayerProfile
  + processResult(result: AnalysisResult)
  + getStatistics()
}


class RingBuffer {
  - capacity: int
  - slots: List<Request>
  - writePointer: int
  - readPointer: int
  - count: int
  
  + isFull(): boolean
  + isEmpty(): boolean
  + write(req: Request): Request
  + readNext(): Request
  + findOldest(): Request
}

note right of RingBuffer
  Хранит заявки в кольцевом буфере.
  findOldest() ищет заявку с минимальным
  generationTime для реализации Д10О3
end note

class DispatcherPlacement {
  - scheduler: EventScheduler
  - logger Logger

  - buffer: RingBuffer ' Ссылка на буфер
  - devices: List<Device> ' Ссылка на приборы
  
  + handleNewRequest(req: Request) 'Реакция на триггер: пришла заявка
  - findFreeDevice(): Device ' Логика Д2П1
}

class DispatcherSelection {
  - scheduler: EventScheduler
  - logger Logger

  - buffer: RingBuffer ' Ссылка на буфер
  - devices: List<Device> ' Ссылка на приборы
  
  + handleDeviceFree(device: Device) ' Реакция на триггер: прибор освободился
  - selectNextRequest(): Request ' Логика Д2Б3
  - assignToDevice(req: Request, device: Device)
}

class Device {
  - currentRequest: Request
  - scheduler: EventScheduler
  - handler: RequestHandler
  - logger Logger

  - id: int ' Для Д2П1
  - mu: double ' Параметр для ПЗ1
  - isBusy: boolean

  - generateServiceTime(): double
  + start(req: Request, now: double): double
  + finish(now: double): Request
  + isFree(): boolean
  + getBusyTime(): double
  
}
note left of Device
  Обращается к обработчику реквестов
  Использует свои вычислительные мощности для исполнения
  анализа через анализатор обработчика и сохранения в
  хранилище обработчика
end note

Device --> EventScheduler : планирует SERVICE_END
Device --> RequestHandler : уведомляет об окончании

class AntiCheatHandler {
  - analyzer: TelemetryAnalyzer
  - resultStore: PlayerProfileStore
  
  + onServed(req: Request, finishTime: double)
}
note top of AntiCheatHandler
  Описывает кто анализирует реквесты
  Описывает куда складывать результаты анализа реквестов
end note

class EventScheduler {
  - eventQueue: PriorityQueue<Event>
  - logger Logger

  + schedule(event: Event)
  + getNextEvent(): Event
  + isEmpty(): boolean
}

SimulationEngine "1" *-- "*" Source
SimulationEngine "1" *-- "*" Device
SimulationEngine "1" *-- "1" RingBuffer
SimulationEngine "1" *-- "1" DispatcherPlacement
SimulationEngine "1" *-- "1" DispatcherSelection

DispatcherPlacement --> RingBuffer : использует
DispatcherPlacement --> Device : назначает
DispatcherSelection --> RingBuffer : забирает
DispatcherSelection --> Device : назначает


TelemetryAnalyzer ..> AnalysisResult : возвращает
PlayerProfileStore "1" *-- "*" PlayerProfile : хранит
PlayerProfileStore --> AnalysisResult : принимает
Request --> TelemetryData : содержит payload

AntiCheatHandler ..|> RequestHandler : реализует
AntiCheatHandler --> TelemetryAnalyzer : использует
AntiCheatHandler --> PlayerProfileStore : сохраняет результат

@enduml